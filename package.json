{
  "name": "@local/dsh-translation-assistant",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Auxiliary translation workspace with sentence/paragraph comparison, editable output, AI retranslation, custom prompts, image OCR translation, full-text copy and scoring, and optional AI scores.",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/index.js",
    "host/engine.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
