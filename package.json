{
  "name": "dsh-translation-assistant",
  "version": "1.17.4",
  "description": "Translate text, files, screenshots, and whole folders; proofread side by side as AI retranslates, scores, and rewrites from your notes. AI at every step.",
  "license": "Apache-2.0",
  "author": "coldgust",
  "type": "module",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "translation",
    "translator",
    "ai-translation",
    "machine-translation",
    "document-translation",
    "file-translation",
    "proofreading",
    "translation-review",
    "image-translation",
    "ocr",
    "i18n",
    "localization",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldgust/dsh-translation-assistant.git"
  },
  "homepage": "https://github.com/coldgust/dsh-translation-assistant",
  "bugs": "https://github.com/coldgust/dsh-translation-assistant/issues",
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "check:pack": "npm pack --dry-run"
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/index.js",
    "host/engine.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
